@startuml
title Secuencia — Registrar Evaluacion (Flujo Completo)

actor "Cliente API" as Cliente
participant "Middleware" as MW
participant "routes/provider.py" as Routes
participant "dependencies.py" as Deps
participant "services/provider.py" as Service
participant "clients.py" as Clients
database "PostgreSQL" as DB
participant "ms-notificaciones" as NOTIF
participant "ms-auditoria" as AUDIT

== Middleware ==
Cliente -> MW : POST /api/v1/evaluaciones\nAuthorization: Bearer <token>\nBody: {proveedor_id, contrato_id, ...}
activate MW
MW -> MW : RequestIDMiddleware: genera request_id
MW -> Routes : request con state.request_id = PRV-{ts}-{uid}
deactivate MW

activate Routes

== Validacion (Dependency Injection) ==
Routes -> Deps : RoleChecker(["Administrador", "Admin"])
activate Deps
Deps -> Clients : AuthClient.validate_session(token)
activate Clients
Clients -> AUTH : POST {auth}/api/v1/auth/session/validate
activate AUTH
AUTH --> Clients : user_data (dict)
deactivate AUTH
Clients --> Deps : user_data (dict)
deactivate Clients
Deps --> Routes : user autorizado
deactivate Deps

== Asignacion del evaluador ==
Routes -> Routes : evaluacion.evaluador_id = user.user_id

== Registro de evaluacion ==
Routes -> Service : EvaluacionService.registrar_evaluacion(data)
activate Service

Service -> Service : puntaje_total = (calidad + cumplimiento_tiempos\n+ precio_competitivo + servicio_postventa) / 4.0

Service -> DB : INSERT INTO evaluaciones
activate DB
DB --> Service : evaluacion creada
deactivate DB

Service -> Service : actualizar_puntaje_proveedor(proveedor_id)
Service -> DB : SELECT evaluaciones WHERE proveedor_id = ?
activate DB
DB --> Service : lista de evaluaciones
deactivate DB
Service -> Service : promedio = sum(puntajes) / count
Service -> DB : UPDATE proveedores SET puntaje_evaluacion = promedio
activate DB
DB --> Service : ok
deactivate DB

alt promedio < 3.0
  Service -> Clients : NotificacionesClient.enviar_puntaje_bajo(razon_social, promedio)
  activate Clients
  Clients -> NOTIF : POST /api/v1/notificaciones/alerta\n{tipo: PROVEEDOR_PUNTAJE_BAJO}
  activate NOTIF
  NOTIF --> Clients : ok
  deactivate NOTIF
  Clients --> Service : ok
  deactivate Clients
end

Service --> Routes : Evaluacion {id, puntaje_total, ...}
deactivate Service

== Auditoria asincrona (BackgroundTasks) ==
Routes -> Routes : registrar_auditoria_bg(background_tasks, trace_id,\n"REGISTRAR_EVALUACION", "POST", 201, ...)
note right
Se agrega tarea a BackgroundTasks
de FastAPI para ejecucion posterior
end note

Routes --> Cliente : StandardResponse {request_id, success=true, data, timestamp}
deactivate Routes

== Ejecucion en Background (post-respuesta) ==
participant FastAPI_BackgroundTasks as BT
BT -> BT : [BackgroundTasks]\nEjecuta tareas pendientes

BT -> Clients : AuditoriaClient.registrar_log(trace_id, action, ...)
activate Clients
Clients -> AUDIT : POST /api/v1/logs\n{trace_id, action, method, status_code, ...}
activate AUDIT
AUDIT --> Clients : 200 OK
deactivate AUDIT
Clients --> BT : ok
deactivate Clients

@enduml
