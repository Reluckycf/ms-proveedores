@startuml
title 6.5 Diagrama de Secuencia - Registrar Evaluacion (Flujo Completo)

actor "Cliente API" as Cliente
participant "routes/provider.py" as Routes
participant "dependencies.py" as Deps
participant "services/provider.py" as Service
participant "models.py" as Models
database "PostgreSQL" as DB

Cliente -> Routes: POST /api/v1/evaluaciones\n(request, proveedor_id, contrato_id, ...)
activate Routes

note over Routes
generar_request_id()
request_id = PRV-timestamp-random
end note

Routes -> Deps: validar_sesion(request)
activate Deps
note over Deps
Verifica token en header Authorization
end note
Deps --> Routes: sesion_data (usuario_id, role_id)
deactivate Deps

Routes -> Deps: validar_permiso(sesion, "PRV_CREATE_EVALUACION")
activate Deps
Deps --> Routes: autorizado=true
deactivate Deps

Routes -> Service: registrar_evaluacion(EvaluacionCreate)
activate Service

Service -> Service: puntaje_total = calcular_promedio(calidad, tiempos, precio, postventa)
note over Service
puntaje_total = (calidad + cumplimiento_tiempos + precio_competitivo + servicio_postventa) / 4
end note

Service -> Models: Evaluacion.create(...)
activate Models
Models -> DB: INSERT INTO evaluaciones
activate DB
DB --> Models: evaluacion_id, puntaje_total
deactivate DB
Models --> Service: evaluacion_obj
deactivate Models

Service -> Service: actualizar_puntaje_proveedor(proveedor_id)
note over Service
Recalcula el puntaje promedio del proveedor
end note

Service -> Models: Evaluacion.select().where(proveedor_id)
activate Models
Models -> DB: SELECT FROM evaluaciones
activate DB
DB --> Models: lista_evaluaciones[]
deactivate DB
Models --> Service: lista_evaluaciones
deactivate Models

Service -> Service: promedio_proveedor = calcular_promedio(lista_evaluaciones)

Service -> Models: Proveedor.update().set(puntaje_evaluacion=promedio)
activate Models
Models -> DB: UPDATE proveedores SET puntaje_evaluacion
activate DB
DB --> Models: ok
deactivate DB
Models --> Service: proveedor_actualizado
deactivate Models

alt promedio_proveedor < 3.0
  Service --> Routes: alerta pendiente (puntaje bajo)
  note over Service
  Se enviara alerta asincronamente
  a ms-notificaciones
  end note
end

Service --> Routes: Evaluacion{id, puntaje_total, ...}
deactivate Service

Routes -> Deps: registrar_auditoria(request_id, "registrar_evaluacion", ...)
activate Deps
Deps --> Routes: ok
deactivate Deps

Routes --> Cliente: StandardResponse\n{request_id, success=true, data, timestamp}
deactivate Routes

@enduml

