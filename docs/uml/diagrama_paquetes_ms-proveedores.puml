@startuml
title Diagrama de Paquetes — ms-proveedores [PRV]

package "ms-proveedores" {
  package "app" {
    package "models" {
      file "models.py" as models_file
    }

    package "routes" {
      file "provider.py" as routes_file
    }

    package "services" {
      file "provider.py" as services_file
    }

    package "schemas" {
      file "provider.py" as schemas_file
    }

    package "utils" {
      file "core.py" as utils_file
    }

    file "clients.py" as clients_file
    file "config.py" as config_file
    file "dependencies.py" as dependencies_file
    file "middleware.py" as middleware_file
    file "logging.py" as logging_file
  }

  file "main.py" as main_file
  file "seed.py" as seed_file
}

package "Infraestructura" {
  file "Dockerfile" as docker_file
  file "docker-compose.yml" as compose_file
  file ".env" as env_file
  file "requirements.txt" as req_file
  file "init_db.sh" as init_db_script
  file "init_postgres.sql" as init_sql
}

database "PostgreSQL" as db_file
entity "ms-autenticacion" as auth_svc
entity "ms-roles" as roles_svc
entity "ms-auditoria" as audit_svc
entity "ms-notificaciones" as notif_svc

main_file --> app

routes_file --> services_file : invoca
routes_file --> schemas_file : valida
routes_file --> dependencies_file : aplica
routes_file --> utils_file : respuesta
routes_file --> clients_file : auditoria

services_file --> models_file : CRUD
services_file --> schemas_file : usa DTOs
services_file --> clients_file : notifica

dependencies_file --> clients_file : validacion
dependencies_file --> config_file : URLs

clients_file --> auth_svc : consulta
clients_file --> roles_svc : consulta
clients_file --> audit_svc : registra
clients_file --> notif_svc : envia

middleware_file --> utils_file : request_id

models_file --> db_file : persiste
services_file --> db_file : accede

note bottom of models_file
Proveedor, Contrato,
Evaluacion, Cotizacion,
DocumentoProveedor
end note

note bottom of services_file
ProveedorService, ContratoService,
EvaluacionService, CotizacionService,
DocumentoService
end note

note bottom of routes_file
Endpoints REST /api/v1/
para proveedores, contratos,
evaluaciones, cotizaciones,
documentos y admin
end note

note bottom of clients_file
AuthClient, RolesClient,
NotificacionesClient,
AuditoriaClient
end note

note bottom of dependencies_file
get_current_user,
RoleChecker,
registrar_auditoria_bg
end note

@enduml
