@startuml
title Secuencia — Validacion de Sesion y Permisos (Flujo Transversal)

actor "Cliente API" as Cliente
participant "Middleware" as MW
participant "routes/provider.py" as Routes
participant "dependencies.py" as Deps
participant "clients.py" as Clients
participant "ms-autenticacion" as AUTH

== 1. Procesamiento Middleware ==
Cliente -> MW : POST /api/v1/<recurso>\nAuthorization: Bearer <token>
activate MW

MW -> MW : LoggingMiddleware: registra start_time
MW -> MW : RequestIDMiddleware:\ngenera request_id PRV-{ts}-{uid}
MW -> Routes : pasa request con state.request_id
deactivate MW

== 2. Validacion de Sesion ==
activate Routes

Routes -> Deps : RoleChecker(user=Depends(get_current_user))
activate Deps

Deps -> Deps : Extraer token del header Authorization
Deps -> Clients : AuthClient.validate_session(token)
activate Clients

Clients -> AUTH : POST /api/v1/auth/session/validate\nBody: {"token": "..."}
activate AUTH
AUTH --> Clients : {"valid": true, "user_id": "...", "role": "Administrador", ...}
deactivate AUTH

Clients --> Deps : user_data (dict)
deactivate Clients

alt Token invalido
  Deps --> Routes : raise HTTPException(401)
  Routes --> Cliente : {"detail": "Sesion invalida o expirada"}
  deactivate Deps
  deactivate Routes
else Token valido
  Deps -> Deps : RoleChecker: user.role in allowed_roles?
  alt Rol no autorizado
    Deps --> Routes : raise HTTPException(403)
    Routes --> Cliente : {"detail": "Rol sin permisos"}
    deactivate Deps
    deactivate Routes
  else Rol autorizado
    Deps --> Routes : user (dict)
    deactivate Deps

    == 3. Ejecucion de Logica de Negocio ==
    Routes -> Routes : Procesar operacion...
    note right
      Cada endpoint ejecuta su
      logica especifica via servicios
    end note

    Routes --> Cliente : StandardResponse {request_id, success, data}
    deactivate Routes
  end
end

note right of AUTH
Microservicio: ms-autenticacion
Valida token JWT de sesion
Retorna datos del usuario autenticado
end note

note right of Deps
RoleChecker verifica solo
el campo "role" del usuario
contra la lista de roles permitidos
NO se hace llamada externa a ms-roles
end note

@enduml
