@startuml
title Casos de uso — ms-proveedores [PRV]
left to right direction

actor "Administrador" as Admin
actor "Empleado" as Emp
actor "ms-autenticacion" as Auth
actor "ms-auditoria" as Audit
actor "ms-notificaciones" as Notif

rectangle "ms-proveedores [PRV]" {
  usecase "Crear proveedor" as UC1
  usecase "Obtener proveedor" as UC2
  usecase "Listar proveedores" as UC3
  usecase "Actualizar proveedor" as UC4
  usecase "Desactivar proveedor" as UC5
  usecase "Verificar contrato\nvigente" as UC6

  usecase "Crear contrato" as UC7
  usecase "Listar contratos\nproximos a vencer" as UC8

  usecase "Registrar evaluacion" as UC9
  usecase "Recalcular puntaje\ndel proveedor" as UC10
  usecase "Enviar alerta por\npuntaje bajo" as UC11

  usecase "Registrar cotizacion" as UC12
  usecase "Comparar cotizaciones\npor descripcion" as UC13

  usecase "Registrar documento" as UC14
  usecase "Listar documentos\nproximos a vencer" as UC15

  usecase "Ejecutar revision\ndiaria" as UC16
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
Admin --> UC12
Admin --> UC14
Admin --> UC15
Admin --> UC16

Emp --> UC2
Emp --> UC3
Emp --> UC6
Emp --> UC13

UC9 ..> UC10 : <<include>>
UC10 ..> UC11 : <<extend>>
UC8 ..> Notif : notifica
UC15 ..> Notif : notifica
UC11 ..> Notif : notifica

note right of Auth
Soporte: validacion
de sesion via
POST /api/v1/auth/session/validate
end note

note right of Audit
Soporte: registro de
operaciones via
POST /api/v1/logs
end note

note right of Notif
Soporte: envio de
alertas via
POST /api/v1/notificaciones/alerta
end note

@enduml
